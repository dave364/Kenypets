{
  "name": "kenypets",
  "compatibility_date": "2026-09-07",
  "main": "worker/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Los links de producto pasan primero por el worker, que les arma la
    // vista previa (foto, nombre y precio). Todo lo demas sale directo.
    "run_worker_first": ["/p/*"]
  },
  // Cada 10 minutos despierta la API (ver worker/index.js)
  "triggers": {
    "crons": ["*/10 * * * *"]
  }
}
